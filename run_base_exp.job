#!/bin/bash
#SBATCH --job-name=base_exp
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4     
#SBATCH --time=08:00:00       
#SBATCH --output=VAULT/BASELINE/%x_%j.out  
#SBATCH --error=VAULT/BASELINE/%x_%j.err

echo "--- Starting Baseline Hyperparameter War ---"
echo "Allocated Node: $SLURMD_NODENAME"

module load 2023
module load Python/3.11.3-GCCcore-12.3.0
source $SLURM_SUBMIT_DIR/thesis_env/bin/activate
cd $SLURM_SUBMIT_DIR

mkdir -p VAULT/BASELINE/

DATA_DIR="/scratch-shared/$USER/data/raw/"
CSV_PATH="/scratch-shared/$USER/data/raw/master_metadata_split.csv"
EPOCHS=25

# echo "=========================================="
# echo "EXPERIMENT 1: Standard Regularization"
# echo "=========================================="
# EXP1_BASE="VAULT/BASELINE/Paths/baseline_exp1_std_reg"

# srun python main.py \
#     --epochs $EPOCHS \
#     --batch_size 32 \
#     --lr 1e-4 \
#     --weight_decay 1e-3 \
#     --dropout 0.5 \
#     --data_dir "$DATA_DIR" \
#     --csv_path "$CSV_PATH" \
#     --save_path "${EXP1_BASE}.pth"

echo "=========================================="
echo "EXPERIMENT 2: Weight Decay Chokehold"
echo "=========================================="
EXP2_BASE="VAULT/BASELINE/Paths/baseline_exp2_decay_choke"

srun python main.py \
    --epochs $EPOCHS \
    --batch_size 32 \
    --lr 1e-4 \
    --weight_decay 1e-2 \
    --dropout 0.6 \
    --data_dir "$DATA_DIR" \
    --csv_path "$CSV_PATH" \
    --save_path "${EXP2_BASE}.pth"

echo "All baseline experiments complete."