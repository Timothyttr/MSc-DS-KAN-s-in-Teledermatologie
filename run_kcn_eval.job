#!/bin/bash
#SBATCH --job-name=eval_vault
#SBATCH --partition=gpu_a100
#SBATCH --gpus=0
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4     
#SBATCH --time=00:15:00       # Evaluation only takes a few minutes
#SBATCH --output=logs/KCN_Evaluations/eval_drop.out  
#SBATCH --error=logs/KCN_Evaluations/val_drop.err

echo "--- Starting Evaluation SLURM Job ---"
echo "Allocated Node: $SLURMD_NODENAME"

# 1. Load the sterile environment
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
source $SLURM_SUBMIT_DIR/thesis_env/bin/activate
cd $SLURM_SUBMIT_DIR

EVAL_SCRIPT="evaluate_kcn.py"

# Paste the exact path to the .pth file you want to unlock
WEIGHT_FILE="logs/KCN/Tuning/20_epochs_kcn_1e3+drop.pth"

# ==========================================

echo "Running $EVAL_SCRIPT on $WEIGHT_FILE..."
srun python $EVAL_SCRIPT --weights "$WEIGHT_FILE"

echo "Evaluation complete."